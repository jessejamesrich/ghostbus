#!/usr/bin/env bash
set -euo pipefail

SESSION="${GHOSTBUS_SESSION:-${AGENTMUX_SESSION:-ghostbus}}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMUX_CONF="${ROOT}/tmux-agent-bus.conf"
STARTER="${ROOT}/bin/start-agent-tmux.sh"
GHOSTBUS="${ROOT}/src/server.cjs"
SEND_LOG="${GHOSTBUS_SEND_LOG:-${HOME}/.local/state/ghostbus/send.log}"
ROLES=(dev orange cicd bohr)
SNAPSHOT_DIR="${GHOSTBUS_SNAPSHOT_DIR:-${HOME}/.local/state/ghostbus/snapshots}"
WORKDIR="${GHOSTBUS_WORKDIR:-${AGENTMUX_WORKDIR:-${PWD}}}"

usage() {
  cat <<'EOF'
ghostbus: manage a tmux-backed agent workspace

Usage:
  ghostbus start [--ephemeral|--persistent] [--dir PATH] [session]
                                   create/attach the 4-pane workspace
  ghostbus attach [session]         attach to an existing workspace
  ghostbus status [session]         show agent panes and coarse state
  ghostbus panes [session]          show raw pane ids/titles/commands
  ghostbus lifecycle [session] [ephemeral|persistent]
                                   show or change close-tab behavior
  ghostbus names [session]          reset pane titles to dev/orange/cicd/bohr
  ghostbus read <role|pane> [lines] read recent pane output
  ghostbus send <role|pane> <text>  paste text into pane and submit/queue
  ghostbus send-file <role|pane> <path>
                                   paste a file into pane and press Enter
  ghostbus type <role|pane> <text>  paste text into pane without Enter
  ghostbus interrupt <role|pane>    send Ctrl-C
  ghostbus snapshot [session]       save recent output for every pane
  ghostbus stop [session]           kill the tmux workspace
  ghostbus doctor [session]         check tmux + ghostbus basics

Examples:
  ghostbus start
  ghostbus start --persistent
  ghostbus status
  ghostbus read bohr 80
  ghostbus send cicd 'git status --short'
  ghostbus send-file bohr prompts/bohr-prompt.txt
  ghostbus interrupt orange

Env:
  GHOSTBUS_SESSION=ghostbus         override default session
  GHOSTBUS_WORKDIR=/path/to/repo    override default workdir
  GHOSTBUS_SEND_LOG=/path/to/log    override send metadata log

Legacy aliases:
  AGENTMUX_SESSION and AGENTMUX_WORKDIR still work for now.
EOF
}

die() {
  printf 'ghostbus: %s\n' "$*" >&2
  exit 1
}

session_arg() {
  if [[ $# -gt 0 && -n "${1:-}" ]]; then
    printf '%s' "$1"
  else
    printf '%s' "$SESSION"
  fi
}

parse_lifecycle_start_args() {
  local lifecycle="ephemeral"
  local session="$SESSION"
  local workdir="$WORKDIR"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ephemeral)
        lifecycle="ephemeral"
        ;;
      --persistent)
        lifecycle="persistent"
        ;;
      --dir|--cwd)
        shift
        [[ $# -gt 0 ]] || die "--dir requires a path"
        workdir="$1"
        ;;
      *)
        session="$1"
        ;;
    esac
    shift
  done
  printf '%s|%s|%s' "$lifecycle" "$session" "$workdir"
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux not found"
}

has_session() {
  tmux has-session -t "$1" 2>/dev/null
}

known_role_from_title() {
  local title
  title="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  local role
  for role in "${ROLES[@]}"; do
    if [[ " $title " == *" $role "* || "$title" == "$role" || "$title" == *"$role"* ]]; then
      printf '%s' "$role"
      return 0
    fi
  done
  return 1
}

role_from_pane_id() {
  local pane="$1"
  local index="${pane##*.}"
  if [[ "$index" =~ ^[0-9]+$ && -n "${ROLES[$index]:-}" ]]; then
    printf '%s' "${ROLES[$index]}"
    return 0
  fi
  return 1
}

role_for_pane() {
  local pane="$1"
  local title="$2"
  known_role_from_title "$title" && return 0
  role_from_pane_id "$pane" && return 0
  printf '%s' "$title"
}

pane_lines() {
  local session="$1"
  tmux list-panes -t "${session}:0" -F '#{session_name}:#{window_index}.#{pane_index}|#{pane_title}|#{pane_current_command}|#{pane_current_path}|#{pane_active}|#{pane_dead}|#{pane_pid}'
}

session_lifecycle() {
  local session="$1"
  local value
  value="$(tmux show-option -t "$session" -v destroy-unattached 2>/dev/null || printf 'off')"
  if [[ "$value" == "on" ]]; then
    printf 'ephemeral'
  else
    printf 'persistent'
  fi
}

set_lifecycle() {
  local session="$1"
  local lifecycle="$2"
  local attached
  case "$lifecycle" in
    ephemeral)
      attached="$(tmux display-message -p -t "$session" '#{session_attached}')"
      if [[ "$attached" == "0" ]]; then
        tmux set-option -t "$session" destroy-unattached off
        tmux set-hook -t "$session" client-attached "set-option -t ${session} destroy-unattached on"
      else
        tmux set-option -t "$session" destroy-unattached on
        tmux set-hook -u -t "$session" client-attached 2>/dev/null || true
      fi
      ;;
    persistent)
      tmux set-option -t "$session" destroy-unattached off
      tmux set-hook -u -t "$session" client-attached 2>/dev/null || true
      ;;
    *)
      die "lifecycle must be ephemeral or persistent"
      ;;
  esac
}

resolve_target() {
  local target="$1"
  if [[ "$target" == *:*.* ]]; then
    printf '%s' "$target"
    return 0
  fi

  local line pane title role
  while IFS='|' read -r pane title _rest; do
    role="$(role_for_pane "$pane" "$title")"
    if [[ "$role" == "$target" || "$title" == "$target" ]]; then
      printf '%s' "$pane"
      return 0
    fi
  done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}|#{pane_title}|#{pane_current_command}|#{pane_current_path}')

  die "no pane matches '$target'"
}

cmd_start() {
  local parsed lifecycle session workdir rest
  parsed="$(parse_lifecycle_start_args "$@")"
  lifecycle="${parsed%%|*}"
  rest="${parsed#*|}"
  session="${rest%%|*}"
  workdir="${rest#*|}"
  exec "$STARTER" "--${lifecycle}" "--dir" "$workdir" "$session"
}

cmd_attach() {
  local session
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"
  exec tmux attach -t "$session"
}

cmd_panes() {
  local session
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"
  pane_lines "$session"
}

cmd_status() {
  local session line pane title command path active dead pid role state
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"

  printf 'session: %s  lifecycle: %s\n' "$session" "$(session_lifecycle "$session")"
  printf '%-8s %-18s %-10s %-7s %s\n' "ROLE" "PANE" "COMMAND" "STATE" "DIR"
  while IFS='|' read -r pane title command path active dead pid; do
    role="$(role_for_pane "$pane" "$title")"
    if [[ "$dead" == "1" ]]; then
      state="dead"
    elif [[ "$active" == "1" ]]; then
      state="active"
    else
      state="running"
    fi
    printf '%-8s %-18s %-10s %-7s %s\n' "$role" "$pane" "$command" "$state" "$path"
  done < <(pane_lines "$session")
}

cmd_lifecycle() {
  local session lifecycle
  session="$SESSION"
  lifecycle=""
  if [[ "${1:-}" == "ephemeral" || "${1:-}" == "persistent" ]]; then
    lifecycle="$1"
  else
    session="$(session_arg "${1:-}")"
    lifecycle="${2:-}"
  fi
  has_session "$session" || die "session '$session' is not running"
  if [[ -z "$lifecycle" ]]; then
    printf '%s\n' "$(session_lifecycle "$session")"
    return 0
  fi
  set_lifecycle "$session" "$lifecycle"
  printf 'session: %s  lifecycle: %s\n' "$session" "$(session_lifecycle "$session")"
}

cmd_names() {
  local session role index
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"
  for index in "${!ROLES[@]}"; do
    role="${ROLES[$index]}"
    tmux select-pane -t "${session}:0.${index}" -T "$role" 2>/dev/null || true
  done
  tmux source-file "$TMUX_CONF"
  cmd_status "$session"
}

cmd_read() {
  local target pane lines
  target="${1:-}"
  [[ -n "$target" ]] || die "read requires role or pane id"
  lines="${2:-120}"
  pane="$(resolve_target "$target")"
  tmux capture-pane -p -J -S "-${lines}" -t "$pane"
}

cancel_copy_mode() {
  local pane="$1"
  local in_mode
  in_mode="$(tmux display-message -p -t "$pane" '#{pane_in_mode}' 2>/dev/null || printf '0')"
  if [[ "$in_mode" == "1" ]]; then
    tmux copy-mode -q -t "$pane" 2>/dev/null || true
  fi
}

submit_key_for_pane() {
  local pane="$1"
  local visible
  visible="$(tmux capture-pane -p -J -t "$pane" 2>/dev/null || true)"
  if printf '%s' "$visible" | grep -Eqi 'tab[[:space:]]+to[[:space:]]+queue|queue[[:space:]]+message'; then
    printf 'Tab'
  else
    printf 'Enter'
  fi
}

log_send() {
  local pane="$1"
  local submit="$2"
  local key="$3"
  local text="$4"
  mkdir -p "$(dirname "$SEND_LOG")"
  printf '%s\tpane=%s\tsubmit=%s\tkey=%s\tbytes=%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$pane" \
    "$submit" \
    "${key:-none}" \
    "${#text}" >>"$SEND_LOG"
}

paste_to_pane() {
  local pane="$1"
  local text="$2"
  local submit="${3:-true}"
  local buffer key
  buffer="ghostbus-$$-${RANDOM}-${RANDOM}"
  cancel_copy_mode "$pane"
  tmux load-buffer -b "$buffer" - <<<"$text"
  tmux paste-buffer -d -b "$buffer" -t "$pane"
  if [[ "$submit" == "true" ]]; then
    sleep "${GHOSTBUS_SUBMIT_DELAY:-${AGENTMUX_SUBMIT_DELAY:-0.5}}"
    key="$(submit_key_for_pane "$pane")"
    tmux send-keys -t "$pane" "$key"
  else
    key=""
  fi
  log_send "$pane" "$submit" "$key" "$text"
}

cmd_send() {
  local target text pane
  target="${1:-}"
  shift || true
  text="$*"
  [[ -n "$target" && -n "$text" ]] || die "send requires role/pane and text"
  pane="$(resolve_target "$target")"
  paste_to_pane "$pane" "$text" true
  printf 'sent to %s\n' "$pane"
}

cmd_send_file() {
  local target path pane text
  target="${1:-}"
  path="${2:-}"
  [[ -n "$target" && -n "$path" ]] || die "send-file requires role/pane and path"
  [[ -f "$path" ]] || die "file not found: $path"
  pane="$(resolve_target "$target")"
  text="$(<"$path")"
  paste_to_pane "$pane" "$text" true
  printf 'sent %s to %s\n' "$path" "$pane"
}

cmd_type() {
  local target text pane
  target="${1:-}"
  shift || true
  text="$*"
  [[ -n "$target" && -n "$text" ]] || die "type requires role/pane and text"
  pane="$(resolve_target "$target")"
  paste_to_pane "$pane" "$text" false
  printf 'typed into %s\n' "$pane"
}

cmd_interrupt() {
  local target pane
  target="${1:-}"
  [[ -n "$target" ]] || die "interrupt requires role or pane id"
  pane="$(resolve_target "$target")"
  tmux send-keys -t "$pane" C-c
  printf 'sent Ctrl-C to %s\n' "$pane"
}

cmd_snapshot() {
  local session stamp path pane title command rest role safe_role pane_file
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"
  stamp="$(date +%Y%m%dT%H%M%S)"
  path="${SNAPSHOT_DIR}/${session}-${stamp}"
  mkdir -p "$path"
  while IFS='|' read -r pane title command rest; do
    role="$(role_for_pane "$pane" "$title")"
    safe_role="$(printf '%s' "$role" | tr -cd '[:alnum:]_.-')"
    [[ -n "$safe_role" ]] || safe_role="pane"
    pane_file="${path}/${safe_role}-${pane//[:.]/_}.txt"
    {
      printf 'role: %s\n' "$role"
      printf 'pane: %s\n' "$pane"
      printf 'title: %s\n' "$title"
      printf 'command: %s\n\n' "$command"
      tmux capture-pane -p -J -S -300 -t "$pane"
    } >"$pane_file"
  done < <(pane_lines "$session")
  printf '%s\n' "$path"
}

cmd_stop() {
  local session
  session="$(session_arg "${1:-}")"
  has_session "$session" || die "session '$session' is not running"
  tmux kill-session -t "$session"
  printf 'stopped %s\n' "$session"
}

cmd_doctor() {
  local session
  session="$(session_arg "${1:-}")"
  require_tmux
  printf 'tmux: %s\n' "$(tmux -V)"
  if has_session "$session"; then
    printf 'session: %s running\n' "$session"
    cmd_status "$session"
  else
    printf 'session: %s not running\n' "$session"
  fi
  if command -v node >/dev/null 2>&1 && [[ -f "$GHOSTBUS" ]]; then
    node "$GHOSTBUS" --selftest >/dev/null && printf 'ghostbus: ok\n' || printf 'ghostbus: failed\n'
  else
    printf 'ghostbus: missing node or server\n'
  fi
}

main() {
  require_tmux
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    start) cmd_start "$@" ;;
    attach) cmd_attach "$@" ;;
    status|ls) cmd_status "$@" ;;
    panes) cmd_panes "$@" ;;
    lifecycle) cmd_lifecycle "$@" ;;
    names) cmd_names "$@" ;;
    read) cmd_read "$@" ;;
    send) cmd_send "$@" ;;
    send-file) cmd_send_file "$@" ;;
    type) cmd_type "$@" ;;
    interrupt|ctrl-c) cmd_interrupt "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    stop|kill) cmd_stop "$@" ;;
    doctor) cmd_doctor "$@" ;;
    *) usage; die "unknown command '$cmd'" ;;
  esac
}

main "$@"
